# Copy to backend/.env for local development. Never commit the real .env.

# Leave empty locally to use a SQLite file (backend/tracker.db).
# Production: your Neon connection string.
DATABASE_URL=

# Optional providers. Leave blank and they are skipped automatically.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
USAJOBS_API_KEY=
USAJOBS_EMAIL=
MUSE_API_KEY=

# Protects POST /admin/refresh. Use a long random string.
ADMIN_TOKEN=

# Comma-separated list of allowed frontend origins ("*" for any).
CORS_ORIGINS=*

# Optional safety net: the API starts a refresh itself if data is older than this.
AUTO_REFRESH_IF_STALE_HOURS=
