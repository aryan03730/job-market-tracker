# Copy to backend/.env for local development. Never commit the real .env.

# Leave empty locally to use a SQLite file (backend/tracker.db).
# Production: your Neon connection string.
DATABASE_URL=

# Optional providers. Leave blank and they are skipped automatically.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
USAJOBS_API_KEY=
USAJOBS_EMAIL=
MUSE_API_KEY=

# Protects POST /admin/refresh. Use a long random string.
ADMIN_TOKEN=

# Comma-separated list of allowed frontend origins ("*" for any).
CORS_ORIGINS=*

# Optional safety net: the API starts a refresh itself if data is older than this.
AUTO_REFRESH_IF_STALE_HOURS=

# ---- Email alerts (optional) ----
# Option 1 (works on Render's free plan, which blocks SMTP ports):
# the Google Apps Script relay in docs/email-relay.gs. When both are set, SMTP is not used.
EMAIL_RELAY_URL=
EMAIL_RELAY_TOKEN=
# Option 2: SMTP (works locally and on GitHub Actions, not on Render's free plan).
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it (no spaces) below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# The address emails come from (for Gmail, the same as SMTP_USER).
ALERT_FROM=
# Used to build confirm/unsubscribe links and the dashboard link in emails.
PUBLIC_API_URL=https://job-market-tracker-c8el.onrender.com
FRONTEND_URL=https://job-market-tracker-sepia.vercel.app
# Set to 1 to print emails in the terminal instead of sending them (local testing).
ALERTS_CONSOLE=
